# Database Configuration
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
# Internal Docker URL
DATABASE_URL=postgresql://jobtracker:jobtracker@postgres:5432/jobtracker

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Ollama fallback (host service; use localhost when backend runs outside Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_THINK=medium
OLLAMA_TIMEOUT_MS=300000

# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Backend Configuration
PORT=3000
SCORE_THRESHOLD=70
# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://yuval-pc:5173

# Frontend Configuration
VITE_API_URL=http://yuval-pc:3000/api
FRONTEND_URL=http://yuval-pc:5173
VITE_ALLOWED_HOSTS=yuval-pc,localhost
